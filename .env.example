# Copiare in .env solo se il file non esiste; non inserire dati o token MIMIC.
LLM_MODEL=qwen3.8:27b
# Endpoint del progetto via Tailscale; sostituire per un altro server Ollama.
LLM_OLLAMA_BASE_URL=http://spark-413e.tail9c981a.ts.net:11434/v1
LLM_BASE_URL=http://spark-413e.tail9c981a.ts.net:8000/v1
LLM_API_KEY=not-required
LLM_TIMEOUT=300
LLM_FIRST_TEXT_TIMEOUT=240
LLM_GEMMA_MISTRAL_TIMEOUT=600
# Percorso assoluto opzionale dell'archivio privato (fuori dalla repo).
# TESI_PRIVATE_DIR=/percorso/privato/codice-tesi-private
# TESI_SPARK_ARCHIVE_DIR=TEST-SPARK-QWEN
